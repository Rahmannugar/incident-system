{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "scripts/**/*.ts",
    "apps/identity/**/*.ts",
    "apps/order/test/**/*.ts",
    "apps/inventory/test/**/*.ts",
    "packages/contracts/gen/ts/**/*.ts",
    "apps/payment/**/*.ts",
    "packages/qstash/**/*.ts",
    "apps/gateway/test/**/*.ts",
    "apps/notification/**/*.ts",
    "packages/telemetry/ts/**/*.ts"
  ]
}
