{
  "srcDir": "apps/payment/src/payments",
  "transforms": [
    {
      "mode": "sql",
      "include": "payments.sql",
      "emitTemplate": "{{dir}}/{{name}}.queries.ts"
    },
    {
      "mode": "sql",
      "include": "outbox.sql",
      "emitTemplate": "{{dir}}/{{name}}.queries.ts"
    },
    {
      "mode": "sql",
      "include": "refunds.sql",
      "emitTemplate": "{{dir}}/{{name}}.queries.ts"
    }
  ],
  "failOnError": true,
  "maxWorkerThreads": 1,
  "db": {
    "ssl": false
  }
}
